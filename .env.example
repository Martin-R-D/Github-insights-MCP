# GitHub personal access token. Required.
# Classic PAT with scopes: repo, read:user, read:org
# See the README for step-by-step generation instructions.
GITHUB_TOKEN=

# The GitHub login (username) whose activity you want insights for. Required.
GITHUB_USERNAME=

# IANA time zone used to bucket activity into local days/weeks.
# Examples: UTC, America/New_York, Europe/Sofia, Asia/Tokyo
TIMEZONE=UTC

# Path to the local SQLite cache database.
DB_PATH=./data/github.db

# Log verbosity written to stderr: debug | info | warn | error
LOG_LEVEL=info
