{
  "name": "github-insights-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing GitHub activity insights over stdio",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "github-insights-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch --onSuccess \"node dist/index.js\"",
    "build": "tsup",
    "start": "node dist/index.js",
    "sync": "node dist/bin/sync.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@octokit/graphql": "^8.1.1",
    "@octokit/rest": "^21.1.1",
    "better-sqlite3": "^12.2.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.7",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "nock": "^13.5.6",
    "node-fetch": "^3.3.2",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
